# Bot token from BotFather
TELEGRAM_BOT_TOKEN=123456789:your_bot_token_here

# Payment provider token configured in @BotFather (/mybots -> Payments)
TELEGRAM_PROVIDER_TOKEN=381764678:TEST:12345

# Public bot username without @, e.g. my_bank_bot
TELEGRAM_BOT_USERNAME=my_bank_bot

# Optional
PORT=3000

# Optional CORS origin for separated frontend/backend deployments
# Example: https://yourname.github.io
CORS_ORIGIN=*
